meta {
  name: token.store
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/tokens
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
    "name": "Example name",
    "password": "{{current_password}}"
}
}
