{
    "info": {
        "name": "Wmo Utrecht API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Set the token environment variable to a personal access token from the web app. A booking requires a resident ID, a future ISO 8601 timestamp with an offset, and an Idempotency-Key. The token endpoints require a web session with CSRF protection."
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "resident.index",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/residents",
                "description": "Lists residents registered in Utrecht, including those without a Wmo authorization.\nThe `search` parameter matches names and resident references. Follow `links.next` for the next page."
            }
        },
        {
            "name": "resident.show",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/residents/{{resident}}",
                "description": "Includes the home address, Wmo authorization and budget periods when available."
            }
        },
        {
            "name": "ride.index",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/rides",
                "description": "Returns rides assigned to the authenticated taxi company. The `from` and `to` dates\nare inclusive and use Amsterdam time."
            }
        },
        {
            "name": "ride.store",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Idempotency-Key",
                        "value": "{{idempotency_key}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/rides",
                "description": "The Wmo authorization must be active at booking and on the ride date.\nThe resident's home address determines the parcel. The ride date determines\nwhich taxi assignment and budget period apply. A successful booking debits that budget immediately.\nSend `scheduled_at` as a future ISO 8601 timestamp with a UTC offset or `Z`.\n\nThe same account, key and booking details return the existing ride with HTTP 201.",
                "body": {
                    "mode": "raw",
                    "raw": "\"Example \"",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            }
        },
        {
            "name": "me",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/me",
                "description": "Get the authenticated account"
            }
        },
        {
            "name": "dashboard",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/dashboard",
                "description": "Ride totals cover the taxi company's assignments or the callcenter account's bookings.\nMunicipal accounts get aggregate resident, authorization, budget and parcel figures."
            }
        },
        {
            "name": "token.index",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/tokens",
                "description": "Lists token metadata for the signed-in account. Requires a web session."
            }
        },
        {
            "name": "token.store",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/tokens",
                "description": "Requires a web session and the account password. Abilities are assigned by role.\nThe token expires after 30 days. The plaintext value appears only in the creation response.",
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Example name\",\n    \"password\": \"{{current_password}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            }
        },
        {
            "name": "token.destroy",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/v1/tokens/{{token_id}}",
                "description": "Requires a web session. The token must belong to the signed-in account."
            }
        }
    ]
}
